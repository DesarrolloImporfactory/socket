#!/bin/sh
# ─────────────────────────────────────────────────────────────
# Candado del motor IA — corre ANTES de cada push.
#
# Si el push toca el motor del bot (contextoColumna, fileSearch, resolver de
# anuncios, kanban_ia, webhook), corre scripts/bateria_regresion.js (Suite A:
# determinista, segundos). Si la batería falla, EL PUSH NO SALE — y como el
# push a develop es lo que dispara el deploy, nada roto llega al servidor.
#
# Es la PRIMERA línea de defensa (por máquina). La definitiva es el gate del
# merge a main en GitHub Actions, que no depende de la configuración local.
#
# Se activa una vez por máquina con:
#   git config core.hooksPath .githooks
#
# Saltarlo (emergencia consciente, no costumbre):
#   SKIP_BATERIA=1 git push       o       git push --no-verify
# ─────────────────────────────────────────────────────────────

[ -n "$SKIP_BATERIA" ] && exit 0

MOTOR='^src/utils/contextoColumna\.js$|^src/utils/palabrasFrecuentesChat\.json$|^src/utils/dedupeMedia\.js$|^src/utils/openia/|^src/utils/webhook_whatsapp/|^src/services/kanban_ia\.service\.js$|^src/services/syncCatalogoKanbanColumna\.service\.js$|^src/controllers/webhook_meta_whatsapp\.controller\.js$'

toca=0
while read local_ref local_sha remote_ref remote_sha; do
  case "$remote_sha" in
    0000000000000000000000000000000000000000)
      # Rama nueva en el remoto: comparar contra el punto común con origin.
      base=$(git merge-base "$local_sha" origin/develop 2>/dev/null || git merge-base "$local_sha" origin/main 2>/dev/null)
      rango="${base:+$base..}$local_sha"
      ;;
    *) rango="$remote_sha..$local_sha" ;;
  esac
  if git diff --name-only "$rango" 2>/dev/null | grep -Eq "$MOTOR"; then
    toca=1
  fi
done

[ "$toca" -eq 0 ] && exit 0

echo ""
echo "🔒 Este push toca el motor IA del bot: corriendo la batería de regresión…"
echo "   (SKIP_BATERIA=1 git push para saltarla en una emergencia)"
echo ""

if ! node scripts/bateria_regresion.js; then
  echo ""
  echo "❌ LA BATERÍA FALLÓ: push bloqueado. Arregla lo que salió en rojo"
  echo "   (o agrega el caso nuevo si es un cambio de comportamiento a propósito)."
  exit 1
fi

echo ""
echo "✅ Batería en verde: el push sigue."
exit 0
