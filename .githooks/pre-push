#!/bin/sh
# ─────────────────────────────────────────────────────────────
# Candado del motor IA — corre ANTES de cada push.
#
# Si el push toca el motor del bot (contextoColumna, fileSearch, resolver de
# anuncios, kanban_ia, webhook), corre scripts/bateria_regresion.js (Suite A:
# determinista, segundos). Si la batería falla, EL PUSH NO SALE — y como el
# push a develop es lo que dispara el deploy, nada roto llega al servidor.
#
# Es la PRIMERA línea de defensa (por máquina). La que no depende de la
# configuración local es GitHub Actions: .github/workflows/ci.yml (PR a main) y
# developer.yml (deploy de dev) corren el chequeo de requires de abajo.
#
# Se activa SOLA al hacer `npm install` (script "prepare" de package.json).
# A mano:  git config core.hooksPath .githooks
#
# Saltarlo (emergencia consciente, no costumbre):
#   SKIP_BATERIA=1 git push   → salta solo la batería
#   git push --no-verify      → salta todo el hook
# ─────────────────────────────────────────────────────────────

# ── Requires con las mayúsculas exactas — en TODO push, toque lo que toque ──
# La caída de dev y producción del 2026-09-21 fue un require('../utils/AppError')
# con el archivo llamado appError.js: en Windows resuelve, en el servidor no, y
# entró por un push que ni siquiera tocaba el motor. Es estático (sin base ni
# API keys) y tarda menos de un segundo, por eso no tiene filtro de archivos ni
# lo apaga SKIP_BATERIA.
if ! node scripts/chequearRequires.js; then
  echo "❌ Push bloqueado: ese require tumbaría el servidor al arrancar."
  exit 1
fi

[ -n "$SKIP_BATERIA" ] && exit 0

MOTOR='^src/utils/contextoColumna\.js$|^src/utils/palabrasFrecuentesChat\.json$|^src/utils/dedupeMedia\.js$|^src/utils/fichaPedido\.js$|^src/utils/productoNombrado\.js$|^src/utils/agruparRafaga\.js$|^src/utils/turnoPorCliente\.js$|^src/utils/openia/|^src/utils/webhook_whatsapp/|^src/services/kanban_ia\.service\.js$|^src/services/syncCatalogoKanbanColumna\.service\.js$|^src/controllers/webhook_meta_whatsapp\.controller\.js$|^src/services/producto_wizard(_runtime)?\.service\.js$|^src/utils/wizardProducto/|^scripts/bateria_regresion\.js$'

toca=0
while read local_ref local_sha remote_ref remote_sha; do
  case "$remote_sha" in
    0000000000000000000000000000000000000000)
      # Rama nueva en el remoto: comparar contra el punto común con origin.
      base=$(git merge-base "$local_sha" origin/develop 2>/dev/null || git merge-base "$local_sha" origin/main 2>/dev/null)
      rango="${base:+$base..}$local_sha"
      ;;
    *) rango="$remote_sha..$local_sha" ;;
  esac
  if git diff --name-only "$rango" 2>/dev/null | grep -Eq "$MOTOR"; then
    toca=1
  fi
done

[ "$toca" -eq 0 ] && exit 0

echo ""
echo "🔒 Este push toca el motor IA del bot: corriendo la batería de regresión…"
echo "   (SKIP_BATERIA=1 git push para saltarla en una emergencia)"
echo ""

if ! node scripts/bateria_regresion.js; then
  echo ""
  echo "❌ LA BATERÍA FALLÓ: push bloqueado. Arregla lo que salió en rojo"
  echo "   (o agrega el caso nuevo si es un cambio de comportamiento a propósito)."
  exit 1
fi

echo ""
echo "✅ Batería en verde: el push sigue."
exit 0
