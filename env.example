PORT=
NODE_ENV=
SECRET_JWT_SEED=
JWT_EXPIRE_IN=

DB_DIALECT=
DB_HOST=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_PORT=

# App histórica de Meta ("legacy"). La usan WhatsApp, Instagram y, mientras no
# se migre, Messenger y Meta Ads. Dejar estas variables tal cual.
FB_APP_ID=
FB_APP_SECRET=
FB_PROVIDER_TOKEN=
FB_BUSINESS_ID=
FB_LOGIN_REDIRECT_URI=
# Configuraciones de Business Login de la app legacy (opcionales: hoy el
# frontend las trae quemadas y estas solo se usan si están puestas).
FB_LOGIN_CONFIG_ID=
FB_ADS_LOGIN_CONFIG_ID=

FB_VERIFY_TOKEN=
FB_PAGE_ACCESS_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Segunda app de Meta ("messenger")
#
# La app legacy quedó restringida y no puede obtener acceso avanzado a los
# permisos pages_* ni a los de anuncios. Esta es la app nueva.
#
# DEJARLAS VACÍAS NO CAMBIA NADA: si falta el id o el secreto, la app no se
# registra y todo sigue con la legacy, que es el estado de producción.
FB_MS_APP_ID=
FB_MS_APP_SECRET=
# Configuración de Business Login para Messenger (pages_show_list,
# pages_messaging, pages_manage_metadata, pages_read_engagement,
# pages_read_user_content, pages_manage_engagement).
FB_MS_LOGIN_CONFIG_ID=
# Configuración de Business Login para anuncios. Es OTRA distinta: pide
# ads_management, ads_read y pages_manage_ads.
FB_MS_ADS_LOGIN_CONFIG_ID=

# Interruptores de migración. Cada integración se mueve por separado porque
# son configuraciones de Business Login distintas y se aprueban por separado.
# Valores: "legacy" (por defecto) o "messenger".
#
# Ojo: sólo afectan a las conexiones NUEVAS. Las que ya existen se firman con
# la app anotada en su fila (messenger_pages.fb_app_id /
# meta_ad_connections.fb_app_id), no con lo que diga esto.
FB_MESSENGER_APP=
FB_ADS_APP=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GOOGLE_REDIRECT_URI=
GOOGLE_REDIRECT_URI_DEV=
GOOGLE_OAUTH_STATE_SECRET=
GOOGLE_PUSH_WEBHOOK_URL=

# TikTok Business API Configuration
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_REDIRECT_URI_DEV=

# TikTok Webhooks Configuration
TIKTOK_WEBHOOK_VERIFY_TOKEN=
TIKTOK_WEBHOOK_SECRET=
TIKTOK_WEBHOOK_URL=
# ── Mentorías del ERP (imporsuitpro) ──────────────────────────────
# El ERP agenda la mentoría de implementación en la agenda del equipo y el
# evento sale a Google por el mismo camino que una cita creada a mano.
# Ver src/services/mentorias_erp.service.js
ERP_MENTORIAS_TOKEN=
MENTORIA_CALENDAR_ID=
# Sub-usuarios que atienden, separados por coma. Agregar uno sube la
# capacidad: el mismo horario admite tantas mentorías como mentores haya.
MENTORIA_MENTORES=
MENTORIA_CREATED_BY=
MENTORIA_TZ=America/Guayaquil
# 1 (por defecto) = cualquier cita del calendario tacha el espacio, porque hoy
# todos los asesores comparten la misma cuenta de Google. 0 = solo cuenta lo de
# los mentores, cuando cada uno tenga su propio Google.
MENTORIA_BLOQUEA_TODO=1

# Secreto compartido con imporsuit-pro (PHP) para el endpoint de ImporIA.
# Mismo valor exacto en el .env de los dos repos. Si falta, el endpoint
# responde 503 en vez de quedar abierto. Ver middlewares/imporiaSecret.middleware.js
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IMPORIA_SHARED_SECRET=
