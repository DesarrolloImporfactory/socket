# ── Mentorías del ERP (imporsuitpro) ──────────────────────────────
# El ERP agenda la mentoría de implementación en la agenda del equipo y el
# evento sale a Google por el mismo camino que una cita creada a mano.
# Ver src/services/mentorias_erp.service.js
ERP_MENTORIAS_TOKEN=
MENTORIA_CALENDAR_ID=
# Sub-usuarios que atienden, separados por coma. Agregar uno sube la
# capacidad: el mismo horario admite tantas mentorías como mentores haya.
MENTORIA_MENTORES=
MENTORIA_CREATED_BY=
MENTORIA_TZ=America/Guayaquil
# 1 (por defecto) = cualquier cita del calendario tacha el espacio, porque hoy
# todos los asesores comparten la misma cuenta de Google. 0 = solo cuenta lo de
# los mentores, cuando cada uno tenga su propio Google.
MENTORIA_BLOQUEA_TODO=1

# Secreto compartido con imporsuit-pro (PHP) para el endpoint de ImporIA.
# Mismo valor exacto en el .env de los dos repos. Si falta, el endpoint
# responde 503 en vez de quedar abierto. Ver middlewares/imporiaSecret.middleware.js
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IMPORIA_SHARED_SECRET=
